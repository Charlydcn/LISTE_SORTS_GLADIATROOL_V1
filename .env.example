# Variables publiques du frontend (publishable key, conçue pour le navigateur).
# Copier ce fichier vers .env.local avec les vraies valeurs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Utilisé uniquement pour appliquer les migrations en connexion PostgreSQL directe.
# Ne placez jamais la vraie valeur dans un fichier versionné.
SUPABASE_DB_PASSWORD=
